FROM node:26-bookworm-slim AS build

RUN apt-get update -y && \
  apt-get upgrade -y && \
  apt-get install -y \
  build-essential \
  gcc autoconf \
  automake \
  zlib1g-dev \
  libpng-dev \
  nasm bash \
  git \
  && apt-get clean

ENV NODE_ENV=production

WORKDIR /app

COPY .yarn ./.yarn
COPY config ./config
COPY database ./database
COPY patches ./patches
COPY public ./public
COPY src ./src
COPY types ./types

COPY .env \
  .nvmrc \
  .yarnrc.yml \
  favicon.png \
  package.json \
  entrypoint.sh \
  tsconfig.json \
  yarn.lock \
  ./

# Node images no longer ship yarn, and corepack was removed from Node in 25.x,
# so invoke the yarn release vendored in .yarn/releases directly.
RUN node .yarn/releases/yarn-3.6.3.cjs install

RUN node .yarn/releases/yarn-3.6.3.cjs build

# Copy only the built files into the final image
FROM node:26-bookworm-slim AS runner
RUN apt-get update -y && \
  apt-get upgrade -y && \
  apt-get clean

ENV NODE_ENV=production

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 strapi

COPY --from=build --chown=strapi:nodejs /app ./

USER strapi

EXPOSE 1337
ENTRYPOINT ["/app/entrypoint.sh"]
